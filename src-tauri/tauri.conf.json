{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Migrador Odoo",
  "version": "0.1.0",
  "identifier": "com.odoo.migrator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Migrador Odoo",
        "width": 1100,
        "height": 780,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../python-engine/*.py",
      "../python-engine/migrator/*.py",
      "../python-engine/transformers/*.py",
      "../python-engine/connectors/*.py",
      "../python-engine/requirements.txt"
    ]
  }
}
