# Configuración SMTP para emails de resumen de migración
# Copia este archivo como ".env" y rellena los valores

# ── Servidor SMTP ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

# ── Cuenta remitente ───────────────────────────────────────────
SMTP_USER=migraciones@tecniloop.es
SMTP_PASSWORD=tu_app_password_aqui

# ── Dirección "De:" (opcional, por defecto se usa SMTP_USER) ───
# SMTP_FROM=Migrador de Datos <migraciones@tecniloop.es>
